  "repository": {
    "type": "git",
    "url": "https://github.com/thijs-hakkenberg/archimate-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fast-xml-parser": "^5.10.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
